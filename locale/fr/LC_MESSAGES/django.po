msgstr "Vous n’êtes pas membre de ce centre."

#: api/permissions.py:29
msgid "Only a center admin can do this."
msgstr "Seul un administrateur du centre peut effectuer cette action."

#: api/permissions.py:40
msgid ""
"This center is not operational: it is pending review, rejected or suspended."
msgstr ""
"Ce centre n’est pas opérationnel : il est en attente d’examen, refusé ou "
"suspendu."

