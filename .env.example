# Environment for the Musnid backend.
# Copy to .env and fill in the values. Never commit .env.
# Empty values are treated as unset. Full reference:
# docs/getting-started/configuration.md

# --- Django -------------------------------------------------------------
# Required. Long random string. Use a URL-safe alphabet: Docker Compose
# interpolates "$" in env files. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Optional. Only the exact string True enables debug mode. Default: off.
DJANGO_DEBUG=False

# Optional. Comma-separated host names Django may serve. Default: none
# (with DJANGO_DEBUG=True, Django still allows localhost and 127.0.0.1).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional. Comma-separated origins allowed to call /api/ from a browser,
# e.g. https://app.example.org,http://localhost:3000. Default: none (no CORS).
DJANGO_CORS_ALLOWED_ORIGINS=

# --- Secrets at rest ------------------------------------------------------
# Optional, required to store API keys in the admin. Fernet keys, comma-separated,
# newest first: the first encrypts, all decrypt. To rotate, put a new key first
# and keep the old ones until every secret was re-added. Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never reuse DJANGO_SECRET_KEY.
FIELD_ENCRYPTION_KEYS=

# Optional. Fallback OpenAI key, used only when no active key was added in the admin.
OPENAI_API_KEY=

# --- Telegram bot (ADR 0022) -------------------------------------------------
# Optional. Token from @BotFather; empty turns the bot off (nothing is sent).
TELEGRAM_BOT_TOKEN=
# Optional. Public origin of this backend, for admin links in Telegram messages,
# for example https://api.musnid.online. Empty: no link.
DJANGO_SITE_URL=
# Optional. Secret Telegram sends with each webhook update (production only;
# letters, digits, _ and -). Empty: the webhook answers 404. Locally, use
# "manage.py telegram_poll" instead (ADR 0023).
TELEGRAM_WEBHOOK_SECRET=

# --- Asking (ADR 0017) -----------------------------------------------------
# Optional. Questions per UTC day across all askers; past it the API answers 429
# "daily_capacity" without calling OpenAI. Default: 150.
ASK_DAILY_LIMIT=150
# Optional. Number of proxies in front of the app, so per-IP limits see the
# client IP from X-Forwarded-For. 0 locally (default); 1 behind the host proxy.
DJANGO_NUM_PROXIES=0

# --- HTTPS (production, ADR 0018) -------------------------------------------
# Optional. Only the exact string True enables it. Behind the host nginx with a
# certificate: trusts X-Forwarded-Proto, HTTPS-only cookies, HTTP redirects to
# HTTPS. Leave empty locally. Default: off.
DJANGO_HTTPS=
# Optional. Seconds browsers must use HTTPS for this host (HSTS). Set only once
# HTTPS works; raise in steps (docs/getting-started/deployment.md). Default: 0.
DJANGO_HSTS_SECONDS=

# --- CrewAI ---------------------------------------------------------------
# Optional. Settings default to these values; keep them. They turn off CrewAI's
# telemetry and tracing. They do not stop the first-run trace prompt: the agents
# app declines it at startup (agents/tracing.py).
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
CREWAI_TRACING_ENABLED=false

# --- PostgreSQL ---------------------------------------------------------
# Required. Also used by the db container to create the database and role.
POSTGRES_DB=musnid
POSTGRES_USER=musnid
POSTGRES_PASSWORD=

# Optional. Defaults match the db service published by docker-compose.yml.
# The web container overrides these to db:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
